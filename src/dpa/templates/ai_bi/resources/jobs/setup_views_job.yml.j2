{% set slug = project_slug | replace('-', '_') %}
resources:
  jobs:
    {{ slug }}_setup_views:
      name: "AI/BI Demo - Setup Metric Views"
      queue:
        enabled: true
      performance_target: PERFORMANCE_OPTIMIZED
      environments:
        - environment_key: Default
          spec:
            environment_version: "5"
      tasks:
        - task_key: create_metric_views
          environment_key: Default
          notebook_task:
            notebook_path: ${workspace.file_path}/notebooks/setup_metric_views
            source: WORKSPACE
            base_parameters:
              catalog: ${var.catalog}
              schema: ${var.schema}
