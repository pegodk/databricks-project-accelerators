# Local configuration for live Databricks integration tests.
# Copy this file to .env, then set DATABRICKS_TOKEN to a personal access token.
# The .env file is ignored by Git; never commit credentials.
DATABRICKS_HOST=https://dbc-b208d150-24a9.cloud.databricks.com/
DATABRICKS_PROFILE=

# Set to 1 only to retain a deployment for debugging. Tests destroy deployments by default.
DPA_KEEP_DEPLOYED=
