# Local configuration for live Databricks integration tests.
# Copy this file to .env after logging in with `databricks auth login`.
# This names a local OAuth profile; it is not a credential.
DATABRICKS_HOST=https://<your-workspace-url>
DATABRICKS_CONFIG_PROFILE=dpa-integration

# Set to 1 only to retain a deployment for debugging. Tests destroy deployments by default.
DPA_KEEP_DEPLOYED=
